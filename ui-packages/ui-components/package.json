{
  "name": "@bcmi-labs/cloud-editor-ui-components",
  "private": true,
  "version": "1.4.4",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "storybook": "yarn run -T storybook dev -p 6006",
    "build-storybook": "yarn run -T storybook build",
    "test": "yarn run -T vitest",
    "test:watch": "yarn run -T vitest watch",
    "test:ui": "yarn run -T vitest --ui",
    "coverage": "yarn run -T vitest run --coverage"
  },
  "exports": {
    ".": {
      "import": "./lib/index.ts"
    },
    "./lib/components-by-app/app-lab": {
      "import": "./lib/components-by-app/app-lab/index.ts"
    },
    "./lib/components-by-app/shared": {
      "import": "./lib/components-by-app/shared/index.ts"
    },
    "./lib/editor-tabs-bar": {
      "import": "./lib/editor-tabs-bar/index.ts"
    },
    "./public/shared.module.scss": {
      "import": "./public/shared.module.scss"
    },
    "./public/index.scss": {
      "import": "./public/index.scss"
    },
    "./lib/keywords": {
      "import": "./lib/keywords.ts"
    },
    "./lib/dialogs/app-lab/duplicate-file-dialog/types": {
      "import": "./lib/dialogs/app-lab/duplicate-file-dialog/types.ts"
    },
    "./public/art-ui.scss": {
      "import": "./public/art-ui.scss"
    },
    "./public/ce-tokens.scss": {
      "import": "./public/ce-tokens.scss"
    },
    "./public/al-tokens.scss": {
      "import": "./public/al-tokens.scss"
    },
    "./lib/common/utils": {
      "import": "./lib/common/utils/index.ts"
    },
    "./lib/*": {
      "import": "./lib/*.ts"
    }
  }
}
